#!/usr/bin/env bash
# bin/secrets: the secret scan. History here is public from the first push, so a secret must be
# stopped before it leaves a machine. The pre-push hook and CI both run this.
#
#   bin/secrets                    # every commit of every ref in this clone
#   bin/secrets <git log options>  # the commits a range names, e.g. origin/main..HEAD
#
# gitleaks runs its default rules plus the rules in .gitleaks.toml. A finding prints a place and
# never the value.
#
# Exit codes: 0 clean, 1 a finding or a range that cannot be read, 75 gitleaks is missing (run
# bin/setup).
set -euo pipefail
cd "$(dirname "$0")/.."
. bin/lib.sh
use_pinned_tools
need git gitleaks

[ "$#" -gt 0 ] || set -- --all

# gitleaks reports "no leaks found" and exits 0 when the git log behind it fails, so the range is
# proven readable here first. A commit this clone does not have (a remote that moved since the
# last fetch) is an error, never a pass.
if ! count="$(git rev-list --count "$@" 2>/dev/null)"; then
  echo "secrets: these commits cannot be read: $*" >&2
  echo '  A commit may be missing from this clone: git fetch, then try again.' >&2
  exit 1
fi
if [ "$count" -eq 0 ]; then
  echo 'secrets: no commits to scan'
  exit 0
fi

exec gitleaks git --config .gitleaks.toml --redact=100 --no-banner --exit-code 1 --log-opts "$*" .
