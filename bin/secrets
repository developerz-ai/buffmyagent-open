#!/usr/bin/env bash
# bin/secrets: the secret scan. History here is public from the first push, so a secret must be
# stopped before it leaves a machine. The pre-push hook and CI both run this.
#
#   bin/secrets                    # every commit reachable from HEAD
#   bin/secrets <git log options>  # the commits a range names, e.g. origin/main..HEAD
#
# gitleaks runs its default rules plus the high-entropy rule in .gitleaks.toml. A finding prints a
# place and never the value.
#
# Exit codes: 0 clean, 1 a finding, 75 gitleaks is missing (run bin/setup).
set -euo pipefail
cd "$(dirname "$0")/.."
. bin/lib.sh
use_pinned_tools
need gitleaks

args=(git --config .gitleaks.toml --redact=100 --no-banner --exit-code 1)
if [ "$#" -gt 0 ]; then
  args+=(--log-opts "$*")
fi
exec gitleaks "${args[@]}" .
